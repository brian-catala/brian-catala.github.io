<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brian | Cybersecurity</title>
    <link rel="icon" type="image/png" href="/avatar.png" />
    
    <style>
      /* Estilos generales oscuros con fondo negro puro y acentos amarillos */
      body {
        margin: 0;
        padding: 0;
        background-color: #000000;
        color: #e2e8f0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      }

      /* Barra de navegación superior */
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        background-color: #09090b;
        border-bottom: 1px solid #27272a;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .logo-container {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      /* Estilo del avatar con brillo amarillo */
      .avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #18181b;
        border: 2px solid #facc15;
        box-shadow: 0 0 10px rgba(250, 204, 21, 0.4);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .avatar img {
        width: 42px;
        height: 42px;
        object-fit: cover;
      }

      .logo-text {
        color: #facc15;
        font-weight: 700;
        font-size: 1.1rem;
        text-decoration: none;
      }

      .nav-right {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      nav ul {
        list-style: none;
        display: flex;
        gap: 1.5rem;
        margin: 0;
        padding: 0;
      }

      /* Estilo de los enlaces del menú */
      nav ul li a {
        color: #facc15;
        text-decoration: none;
        font-size: 0.95rem;
        transition: color 0.2s ease;
      }

      nav ul li a:hover {
        color: #fde047;
        text-decoration: underline;
      }

      /* Botón de cambio de idioma */
      #lang-toggle {
        background-color: #18181b;
        color: #facc15;
        border: 1px solid #facc15;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s ease;
      }

      #lang-toggle:hover {
        background-color: #facc15;
        color: #000000;
      }

      /* Botón de menú hamburguesa (oculto en escritorio) */
      .menu-toggle {
        display: none;
        background: none;
        border: 1px solid #facc15;
        color: #facc15;
        font-size: 1.2rem;
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
        cursor: pointer;
      }

      /* Contenido principal */
      main {
        max-width: 900px;
        margin: 4rem auto;
        padding: 0 1.5rem;
      }

      section {
        margin-bottom: 3rem;
      }

      h2 {
        font-size: 1.5rem;
        color: #facc15;
        border-bottom: 1px solid #27272a;
        padding-bottom: 0.5rem;
        margin-top: 2rem;
      }

      p {
        color: #a1a1aa;
        line-height: 1.6;
      }

      /* Tarjetas */
      .card-list {
        list-style: none;
        padding: 0;
        display: grid;
        gap: 1rem;
      }

      .card {
        background-color: #09090b;
        border: 1px solid #27272a;
        padding: 1.2rem;
        border-radius: 8px;
        transition: border-color 0.2s;
      }

      .card:hover {
        border-color: #facc15;
      }

      .card h3 {
        color: #f8fafc;
        margin: 0 0 0.4rem 0;
        font-size: 1.1rem;
      }

      .card p {
        margin: 0;
        font-size: 0.95rem;
      }

      .card .level {
        display: block;
        margin-top: 0.5rem;
        font-size: 0.85rem;
        color: #facc15;
        font-weight: 500;
      }

      /* Estilo tipo terminal */
      .terminal-box {
        background-color: #09090b;
        border: 1px solid #27272a;
        border-radius: 8px;
        padding: 2.5rem;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
        min-height: 320px;
      }

      .terminal-prompt {
        color: #facc15;
        font-weight: bold;
        margin-top: 1.2rem;
        margin-bottom: 0.2rem;
        font-family: 'Courier New', Courier, monospace;
        min-height: 1.2rem;
      }

      .terminal-prompt:first-child {
        margin-top: 0;
      }

      .terminal-title {
        font-size: 2.5rem;
        color: #f8fafc;
        margin: 0 0 1rem 0;
        font-weight: 700;
        min-height: 3rem;
      }

      .terminal-text {
        color: #a1a1aa;
        margin: 0;
        font-size: 1.05rem;
        min-height: 1.5rem;
      }

      /* Efecto de cursor parpadeante tipo terminal en amarillo */
      .cursor {
        display: inline-block;
        background-color: #facc15;
        width: 8px;
        height: 18px;
        margin-left: 4px;
        animation: blink 1s infinite;
        vertical-align: middle;
      }

      @keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
      }

      /* ========================================== */
      /* DISEÑO RESPONSIVO PARA MÓVILES (< 768px)  */
      /* ========================================== */
      @media (max-width: 768px) {
        header {
          flex-wrap: wrap;
          padding: 1rem;
        }

        .menu-toggle {
          display: block;
        }

        .nav-right {
          width: 100%;
          justify-content: space-between;
          margin-top: 0.5rem;
        }

        nav {
          display: none;
          width: 100%;
          background-color: #09090b;
          border-top: 1px solid #27272a;
          padding-top: 0.5rem;
          margin-top: 0.5rem;
        }

        nav.active {
          display: block;
        }

        nav ul {
          flex-direction: column;
          gap: 0.8rem;
          text-align: center;
          padding: 0.5rem 0;
        }

        main {
          margin: 2rem auto;
          padding: 0 1rem;
        }

        .terminal-box {
          padding: 1.5rem;
          min-height: 340px;
        }

        .terminal-title {
          font-size: 1.8rem;
          min-height: 2.2rem;
        }
      }
    </style>
  </head>
  <body>

    <!-- Cabecera / Navbar -->
    <header>
      <div class="logo-container">
        <div class="avatar">
          <img src="/avatar.png" alt="Brian Català Avatar" />
        </div>
        <a href="#" class="logo-text">brian-catala.github.io</a>
      </div>

      <div class="nav-right">
        <button class="menu-toggle" id="menu-btn">&#9776;</button>
        <button id="lang-toggle">ES</button>
      </div>

      <nav id="nav-menu">
        <ul>
          <li><a href="#home" data-en="home" data-es="inicio">home</a></li>
          <li><a href="#about" data-en="about me" data-es="sobre mí">about me</a></li>
          <li><a href="#progress" data-en="progress" data-es="progreso">progress</a></li>
          <li><a href="#contact" data-en="contact" data-es="contacto">contact</a></li>
        </ul>
      </nav>
    </header>

    <!-- Contenido -->
    <main>
      <section id="home">
        <div class="terminal-box">
          <!-- Elementos de la terminal -->
          <div class="terminal-prompt" id="prompt-whoami"></div>
          <h1 class="terminal-title" id="type-title"></h1>
          
          <div class="terminal-prompt" id="prompt-role"></div>
          <p class="terminal-text" id="type-role" data-en="Cybersecurity Analyst & Future Pentester" data-es="Analista de Ciberseguridad y Futuro Pentester"></p>
          
          <div class="terminal-prompt" id="prompt-specialty"></div>
          <p class="terminal-text" id="type-specialty" data-en="Pentesting · Red Team · Ethical Hacking" data-es="Pentesting · Red Team · Hacking Ético"></p>
          
          <div class="terminal-prompt" id="prompt-status"></div>
          <p class="terminal-text">
            <span id="type-status" data-en="Analyzing attack vectors and networks..." data-es="Analizando vectores de ataque y redes..."></span>
          </p>
        </div>
      </section>

      <section id="about">
        <h2 data-en="About me" data-es="Sobre mí">About me</h2>
        <p data-en="Cybersecurity enthusiast driven by a passion for mastering web pentesting, vulnerability analysis, and network security. Actively honing advanced offensive skills through hands-on labs, CTFs, and real-world simulation, while currently pursuing the eJPTv2 certification to build a world-class technical foundation."
            data-es="Entusiasta de la ciberseguridad impulsado por la pasión de dominar el pentesting web, el análisis de vulnerabilidades y la seguridad de redes. Mejorando activamente habilidades ofensivas avanzadas mediante laboratorios prácticos, CTFs y simulaciones del mundo real, mientras curso actualmente la certificación eJPTv2 para construir una base técnica de primer nivel.">
          Cybersecurity enthusiast driven by a passion for mastering web pentesting, vulnerability analysis, and network security. 
          Actively honing advanced offensive skills through hands-on labs, CTFs, and real-world simulation, while currently pursuing the <strong>eJPTv2</strong> certification to build a world-class technical foundation.
        </p>
        <ul class="card-list" style="margin-top: 1rem;">
          <li class="card"><strong data-en="Core Focus:" data-es="Enfoque Principal:">Core Focus:</strong> <span data-en="Red Team / Pentesting &amp; OWASP Top 10" data-es="Red Team / Pentesting y OWASP Top 10">Red Team / Pentesting &amp; OWASP Top 10</span></li>
          <li class="card"><strong data-en="Active Training:" data-es="Entrenamiento Activo:">Active Training:</strong> <span data-en="Hack The Box &amp; Advanced Local Labs" data-es="Hack The Box y Laboratorios Locales Avanzados">Hack The Box &amp; Advanced Local Labs</span></li>
          <li class="card"><strong data-en="Mindset:" data-es="Mentalidad:">Mindset:</strong> <span data-en="Continuous technical growth and deep offensive mastery" data-es="Crecimiento técnico continuo y profundo dominio ofensivo">Continuous technical growth and deep offensive mastery</span></li>
        </ul>
      </section>

      <!-- Sección de Progreso -->
      <section id="progress">
        <h2 data-en="Progress" data-es="Progreso">Progress</h2>
        <ul class="card-list">
          <li class="card">
            <h3 data-en="Web Pentesting" data-es="Pentesting Web">Web Pentesting</h3>
            <p data-en="Active learning of OWASP Top 10 and basic exploitation." data-es="Aprendizaje activo de OWASP Top 10 y explotación básica.">Active learning of OWASP Top 10 and basic exploitation.</p>
            <span class="level" data-en="Level: in progress" data-es="Nivel: en curso">Level: in progress</span>
          </li>
          <li class="card">
            <h3 data-en="Networks" data-es="Redes">Networks</h3>
            <p data-en="Fundamentals of TCP/IP, DNS, HTTP, and traffic analysis." data-es="Fundamentos de TCP/IP, DNS, HTTP y análisis de tráfico.">Fundamentals of TCP/IP, DNS, HTTP, and traffic analysis.</p>
            <span class="level" data-en="Level: intermediate" data-es="Nivel: intermedio">Level: intermediate</span>
          </li>
          <li class="card">
            <h3 data-en="Linux" data-es="Linux">Linux</h3>
            <p data-en="Daily usage in pentesting environments and basic administration." data-es="Uso diario en entornos de pentesting y administración básica.">Daily usage in pentesting environments and basic administration.</p>
            <span class="level" data-en="Level: intermediate" data-es="Nivel: intermedio">Level: intermediate</span>
          </li>
          <li class="card">
            <h3 data-en="Python" data-es="Python">Python</h3>
            <p data-en="Task automation and security-applied scripting." data-es="Automatización de tareas y scripting aplicado a seguridad.">Task automation and security-applied scripting.</p>
            <span class="level" data-en="Level: basic" data-es="Nivel: básico">Level: basic</span>
          </li>
          <li class="card">
            <h3 data-en="Docker" data-es="Docker">Docker</h3>
            <p data-en="Containerization of practice environments and service deployment." data-es="Contenedorización de entornos de práctica y despliegue de servicios.">Containerization of practice environments and service deployment.</p>
            <span class="level" data-en="Level: in progress" data-es="Nivel: en curso">Level: in progress</span>
          </li>
        </ul>
      </section>

      <section id="contact">
        <h2 data-en="Contact" data-es="Contacto">Contact</h2>
        <p data-en="Want to connect or talk about cybersecurity?" data-es="¿Quieres conectar o hablar sobre ciberseguridad?">Want to connect or talk about cybersecurity?</p>
        <ul class="card-list" style="margin-top: 1rem;">
          <li class="card">GitHub: <a href="https://github.com/brian-catala" target="_blank" style="color: #facc15; text-decoration: none;">github.com/brian-catala</a></li>
          <li class="card">LinkedIn: <a href="https://www.linkedin.com/in/brian-catala/" target="_blank" style="color: #facc15; text-decoration: none;" data-en="Your LinkedIn Profile" data-es="Tu Perfil de LinkedIn">Your LinkedIn Profile</a></li>
        </ul>
      </section>
    </main>

    <!-- Scripts -->
    <script>
      // Menú desplegable móvil
      const menuBtn = document.getElementById('menu-btn');
      const navMenu = document.getElementById('nav-menu');

      menuBtn.addEventListener('click', () => {
        navMenu.classList.toggle('active');
      });

      document.querySelectorAll('nav ul li a').forEach(link => {
        link.addEventListener('click', () => {
          navMenu.classList.remove('active');
        });
      });

      // Función de escritura máquina de escribir
      function typeWriter(element, text, speed = 35, callback) {
        let i = 0;
        element.innerHTML = "";
        
        const cursor = document.createElement('span');
        cursor.className = 'cursor';
        element.appendChild(cursor);

        function typing() {
          if (i < text.length) {
            element.insertBefore(document.createTextNode(text.charAt(i)), cursor);
            i++;
            setTimeout(typing, speed);
          } else {
            if (callback) {
              cursor.remove();
              callback();
            }
          }
        }
        typing();
      }

      let currentLang = 'en';

      function runTerminalAnimation() {
        const pWhoami = document.getElementById('prompt-whoami');
        const titleEl = document.getElementById('type-title');
        const pRole = document.getElementById('prompt-role');
        const roleEl = document.getElementById('type-role');
        const pSpecialty = document.getElementById('prompt-specialty');
        const specialtyEl = document.getElementById('type-specialty');
        const pStatus = document.getElementById('prompt-status');
        const statusEl = document.getElementById('type-status');

        pWhoami.innerHTML = "";
        titleEl.innerHTML = "";
        pRole.innerHTML = "";
        roleEl.innerHTML = "";
        pSpecialty.innerHTML = "";
        specialtyEl.innerHTML = "";
        pStatus.innerHTML = "";
        statusEl.innerHTML = "";

        const roleText = roleEl.getAttribute(`data-${currentLang}`);
        const specialtyText = specialtyEl.getAttribute(`data-${currentLang}`);
        const statusText = statusEl.getAttribute(`data-${currentLang}`);

        typeWriter(pWhoami, "> whoami", 30, () => {
          typeWriter(titleEl, "Brian Catalá", 35, () => {
            typeWriter(pRole, "> role", 30, () => {
              typeWriter(roleEl, roleText, 25, () => {
                typeWriter(pSpecialty, "> specialty", 30, () => {
                  typeWriter(specialtyEl, specialtyText, 25, () => {
                    typeWriter(pStatus, "> status", 30, () => {
                      typeWriter(statusEl, statusText, 25);
                    });
                  });
                });
              });
            });
          });
        });
      }

      window.addEventListener('DOMContentLoaded', () => {
        setTimeout(runTerminalAnimation, 100);
      });

      // Cambio de idiomas
      const toggleBtn = document.getElementById('lang-toggle');

      toggleBtn.addEventListener('click', () => {
        currentLang = currentLang === 'en' ? 'es' : 'en';
        toggleBtn.textContent = currentLang === 'en' ? 'ES' : 'EN';
        document.documentElement.lang = currentLang;

        document.querySelectorAll('[data-en]').forEach(el => {
          if(!el.id.startsWith('type-') && !el.id.startsWith('prompt-')) {
            el.innerHTML = el.getAttribute(`data-${currentLang}`);
          }
        });

        runTerminalAnimation();
      });
    </script>
  </body>
</html>