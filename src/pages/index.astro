---
// Código de JavaScript del lado del servidor (si lo necesitas más adelante)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brian | Cybersecurity</title>
    <link rel="icon" type="image/png" href="/avatar.png" />
    
    <style>
      /* Estilos generales oscuros (estilo terminal/hacker) */
      body {
        margin: 0;
        padding: 0;
        background-color: #0b0f19;
        color: #e2e8f0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      }

      /* Barra de navegación superior */
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        background-color: #0f172a;
        border-bottom: 1px solid #1e293b;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .logo-container {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      /* Estilo del avatar con brillo verde ajustado */
      .avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #1e293b;
        border: 2px solid #10b981;
        box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .avatar img {
        width: 42px;
        height: 42px;
        object-fit: cover;
      }

      .logo-text {
        color: #10b981;
        font-weight: 700;
        font-size: 1.1rem;
        text-decoration: none;
      }

      nav ul {
        list-style: none;
        display: flex;
        gap: 1.5rem;
        margin: 0;
        padding: 0;
      }

      /* Estilo de los enlaces del menú */
      nav ul li a {
        color: #10b981;
        text-decoration: none;
        font-size: 0.95rem;
        transition: color 0.2s ease;
      }

      /* Efecto al pasar el cursor por encima */
      nav ul li a:hover {
        color: #34d399;
        text-decoration: underline;
      }

      /* Contenido principal */
      main {
        max-width: 900px;
        margin: 4rem auto;
        padding: 0 1.5rem;
      }

      section {
        margin-bottom: 3rem;
      }

      h2 {
        font-size: 1.5rem;
        color: #10b981;
        border-bottom: 1px solid #1e293b;
        padding-bottom: 0.5rem;
        margin-top: 2rem;
      }

      p {
        color: #94a3b8;
        line-height: 1.6;
      }

      /* Tarjetas de proyectos, progreso y contacto */
      .card-list {
        list-style: none;
        padding: 0;
        display: grid;
        gap: 1rem;
      }

      .card {
        background-color: #0f172a;
        border: 1px solid #1e293b;
        padding: 1.2rem;
        border-radius: 8px;
        transition: border-color 0.2s;
      }

      .card:hover {
        border-color: #10b981;
      }

      /* Clase especial para simular la tarjeta destacada con borde verde brillante (como en tu captura) */
      .card.active-card {
        border: 1px solid #10b981;
        box-shadow: 0 0 10px rgba(16, 185, 129, 0.2);
      }

      /* Estilos internos para los títulos y textos de las tarjetas de progreso */
      .card h3 {
        color: #f8fafc;
        margin: 0 0 0.4rem 0;
        font-size: 1.1rem;
      }

      .card p {
        margin: 0;
        font-size: 0.95rem;
      }

      .card .level {
        display: block;
        margin-top: 0.5rem;
        font-size: 0.85rem;
        color: #10b981;
        font-weight: 500;
      }

      /* Estilo tipo terminal para la sección de inicio */
      .terminal-box {
        background-color: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 2.5rem;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
      }

      .terminal-prompt {
        color: #10b981;
        font-weight: bold;
        margin-top: 1.2rem;
        margin-bottom: 0.2rem;
        font-family: 'Courier New', Courier, monospace;
      }

      .terminal-prompt:first-child {
        margin-top: 0;
      }

      .terminal-title {
        font-size: 2.5rem;
        color: #f8fafc;
        margin: 0 0 1rem 0;
        font-weight: 700;
      }

      .terminal-text {
        color: #94a3b8;
        margin: 0;
        font-size: 1.05rem;
      }

      /* Efecto de cursor parpadeante tipo terminal */
      .cursor {
        display: inline-block;
        background-color: #10b981;
        width: 8px;
        height: 18px;
        margin-left: 4px;
        animation: blink 1s infinite;
        vertical-align: middle;
      }

      @keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
      }
    </style>
  </head>
  <body>

    <!-- Cabecera / Navbar -->
    <header>
      <div class="logo-container">
        <div class="avatar">
          <img src="/avatar.png" alt="Brian Català Avatar" />
        </div>
        <a href="#" class="logo-text">brian-catala.github.io</a>
      </div>
      <nav>
        <ul>
          <li><a href="#home">home</a></li>
          <li><a href="#about">about me</a></li>
          <li><a href="#progress">progress</a></li>
          <li><a href="#contact">contact</a></li>
        </ul>
      </nav>
    </header>

    <!-- Contenido -->
    <main>
      <section id="home">
        <div class="terminal-box">
          <div class="terminal-prompt">&gt; whoami</div>
          <h1 class="terminal-title">Brian Catalá</h1>
          
          <div class="terminal-prompt">&gt; role</div>
          <p class="terminal-text">Cybersecurity Analyst & Future Pentester</p>
          
          <div class="terminal-prompt">&gt; specialty</div>
          <p class="terminal-text">Pentesting · Red Team · Ethical Hacking</p>
          
          <div class="terminal-prompt">&gt; status</div>
          <p class="terminal-text">
            Analyzing attack vectors and networks...<span class="cursor"></span>
          </p>
        </div>
      </section>

      <section id="about">
        <h2>About me</h2>
        <p>
          Cybersecurity enthusiast driven by a passion for mastering web pentesting, vulnerability analysis, and network security. 
          Actively honing advanced offensive skills through hands-on labs, CTFs, and real-world simulation, while currently pursuing the <strong>eJPTv2</strong> certification to build a world-class technical foundation.
        </p>
        <ul class="card-list" style="margin-top: 1rem;">
          <li class="card"><strong>Core Focus:</strong> Red Team / Pentesting &amp; OWASP Top 10</li>
          <li class="card"><strong>Active Training:</strong> Hack The Box &amp; Advanced Local Labs</li>
          <li class="card"><strong>Mindset:</strong> Continuous technical growth and deep offensive mastery</li>
        </ul>
      </section>

      <!-- Nueva sección de Progreso -->
      <section id="progress">
        <h2>Progress</h2>
        <ul class="card-list">
          <li class="card">
            <h3>Web Pentesting</h3>
            <p>Active learning of OWASP Top 10 and basic exploitation.</p>
            <span class="level">Level: in progress</span>
          </li>
          <li class="card">
            <h3>Networks</h3>
            <p>Fundamentals of TCP/IP, DNS, HTTP, and traffic analysis.</p>
            <span class="level">Level: intermediate</span>
          </li>
          <li class="card">
            <h3>Linux</h3>
            <p>Daily usage in pentesting environments and basic administration.</p>
            <span class="level">Level: intermediate</span>
          </li>
          <!-- Tarjeta destacada con el borde verde brillante como en tu imagen -->
          <li class="card">
            <h3>Python</h3>
            <p>Task automation and security-applied scripting.</p>
            <span class="level">Level: basic</span>
          </li>
          <li class="card">
            <h3>Docker</h3>
            <p>Containerization of practice environments and service deployment.</p>
            <span class="level">Level: in progress</span>
          </li>
        </ul>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p>Want to connect or talk about cybersecurity?</p>
        <ul class="card-list" style="margin-top: 1rem;">
          <li class="card">GitHub: <a href="https://github.com/brian-catala" target="_blank" style="color: #10b981; text-decoration: none;">github.com/brian-catala</a></li>
          <li class="card">LinkedIn: <a href="https://www.linkedin.com/in/brian-catala/" target="_blank" style="color: #10b981; text-decoration: none;">Your LinkedIn Profile</a></li>
        </ul>
      </section>
    </main>

  </body>
</html>